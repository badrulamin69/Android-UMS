<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <!-- Sunken effect when pressed (simulated) -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/bottom_right_shadow" />
                </shape>
            </item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/surface_color" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- Bottom Right Shadow -->
            <item android:bottom="0dp" android:left="3dp" android:right="0dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/bottom_right_shadow" />
                </shape>
            </item>
            <!-- Top Left Highlight -->
            <item android:bottom="3dp" android:left="0dp" android:right="3dp" android:top="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/top_left_highlight" />
                </shape>
            </item>
            <!-- Content Surface -->
            <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/surface_color" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
