<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/neumorphic_card_raised"
    android:padding="16dp">

    <!-- Custom Checkbox (Raised Circle) -->
    <FrameLayout
        android:id="@+id/checkboxFrame"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/neumorphic_button_raised"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivCheck"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@android:drawable/checkbox_on_background"
            android:visibility="gone"
            app:tint="@color/electric_success_green" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvAssignmentTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:text="Vector Calculus Problem Set 4"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/urgencyDot"
        app:layout_constraintStart_toEndOf="@id/checkboxFrame"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDueDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Due: Today, 11:59 PM"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tvAssignmentTitle"
        app:layout_constraintTop_toBottomOf="@id/tvAssignmentTitle" />

    <!-- Urgency Dot -->
    <View
        android:id="@+id/urgencyDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/circle_red"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
